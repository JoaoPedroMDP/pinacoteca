{
  "name": "pinacoteca",
  "version": "0.14.0",
  "description": "board para ver todos os HTMLs de uma pasta lado a lado, com recarga automatica",
  "type": "module",
  "license": "MIT",
  "author": "jpmpjp00@gmail.com",
  "keywords": [
    "html",
    "preview",
    "prototype",
    "board",
    "canvas",
    "live-reload",
    "design",
    "wireframe",
    "static",
    "viewer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoaoPedroMDP/pinacoteca.git"
  },
  "bugs": {
    "url": "https://github.com/JoaoPedroMDP/pinacoteca/issues"
  },
  "homepage": "https://github.com/JoaoPedroMDP/pinacoteca#readme",
  "bin": {
    "pinacoteca": "bin/pinacoteca.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/pinacoteca.js",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test test/unit.mjs",
    "test:e2e": "node test/e2e.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "build-install": "bash scripts/build-install.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "ws": "^8.18.0"
  }
}
